# Tomasz: "Masz miec pelen dostep jak do domu albo dzialki."
# Ta sama zasada co przy Dzialce (wiedza/KONEKTOR_DZIALKA.md):
#  - wystawiona TYLKO sciezka webhooka MCP, reszta HA zwraca 404
#  - naglowki X-Forwarded-* ZDJETE, Host podstawiony — inaczej HA odrzuca ruch (400 Bad Request)
#    i trzeba by dopisywac trusted_proxies w configuration.yaml zdalnej instalacji
sosnowiec.157-90-155-155.sslip.io {
	# 5.08 11:17 — POPRAWKA: Sosnowiec NIE ma webhooka. Serwer MCP jest osiagalny
	# WPROST przez Tailscale na porcie 9583, pod tajna sciezka wygenerowana przez dodatek.
	# Dzieki temu pominięty zostaje pośrednik webhooka — jedno ogniwo mniej.
	@mcp path /private_1S_c5tNNIZ_qWO_4Ks777A*
	handle @mcp {
		reverse_proxy 100.67.61.100:9583 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond "Nie ma tu nic." 404
	}
}
