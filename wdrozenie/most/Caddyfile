# HA DZIALKA — TYLKO webhook MCP, cala reszta Home Assistanta na 404 (propozycja Henia, 29.07)
# Powod: aplikacja Tomasza jest poza Tailnetem, wiec adres .ts.net jest dla niej nieosiagalny.
dzialka.157-90-155-155.sslip.io {
	@mcp path /api/webhook/mcp_25232d954273e3ee9d206037e9ecca84*
	handle @mcp {
		reverse_proxy 100.115.112.5:8123 {
			# HA odrzuca ruch z nieznanego proxy (400 Bad Request). Zdejmujemy naglowki proxy,
			# zeby widzial polaczenie jak zwykle z tailnetu — bez zmian w konfiguracji Dzialki.
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond "Nie ma tu nic." 404
	}
}

