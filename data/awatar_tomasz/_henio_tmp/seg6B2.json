{"segs": [[0.0, 2.74, "Bawimy się podziałkowemu, wspólnym stołem."], [3.2, 7.08, "Zarząd stawia gorącą kiełbaskę, chleb, musztardę i kawę,"], [7.34, 9.8, "a każdy dokłada od siebie, co ma pod ręką."], [10.12, 13.04, "Ciasto, sałatkę, ogórki własnej roboty,"], [13.66, 15.88, "albo koszyk jabłek z własnej działki."], [16.42, 19.82, "Najważniejsze to dobry humor i rodzina, reszta się poskłada."], [20.26, 23.68, "Zapraszamy całe rodziny, dzieciaki też znajdą coś dla siebie."], [24.48, 26.3, "Do zobaczenia w działkowcu."], [27.32, 29.06, "Zarząd rod woźniki."]], "words": [[0.0, "Bawimy", 0.96], [0.68, "się", 1.0], [0.84, "podziałkowemu,", 0.96], [1.82, "wspólnym", 1.0], [2.24, "stołem.", 0.99], [3.2, "Zarząd", 0.99], [3.44, "stawia", 1.0], [3.78, "gorącą", 0.99], [4.28, "kiełbaskę,", 0.92], [5.22, "chleb,", 1.0], [5.74, "musztardę", 1.0], [6.26, "i", 0.99], [6.5, "kawę,", 1.0], [7.34, "a", 0.98], [7.48, "każdy", 1.0], [7.72, "dokłada", 0.97], [8.12, "od", 0.98], [8.3, "siebie,", 1.0], [8.76, "co", 1.0], [8.96, "ma", 1.0], [9.1, "pod", 1.0], [9.32, "ręką.", 1.0], [10.12, "Ciasto,", 0.95], [10.82, "sałatkę,", 1.0], [11.74, "ogórki", 1.0], [12.1, "własnej", 1.0], [12.52, "roboty,", 1.0], [13.66, "albo", 0.99], [14.1, "koszyk", 0.99], [14.54, "jabłek", 0.99], [14.86, "z", 0.99], [15.06, "własnej", 1.0], [15.38, "działki.", 1.0], [16.42, "Najważniejsze", 1.0], [16.98, "to", 0.94], [17.16, "dobry", 1.0], [17.44, "humor", 0.99], [17.78, "i", 0.99], [18.1, "rodzina,", 0.99], [18.84, "reszta", 1.0], [19.12, "się", 1.0], [19.32, "poskłada.", 0.99], [20.26, "Zapraszamy", 1.0], [20.8, "całe", 0.99], [21.06, "rodziny,", 1.0], [21.96, "dzieciaki", 1.0], [22.3, "też", 0.99], [22.6, "znajdą", 1.0], [22.92, "coś", 1.0], [23.12, "dla", 1.0], [23.34, "siebie.", 1.0], [24.48, "Do", 1.0], [24.66, "zobaczenia", 1.0], [25.32, "w", 0.99], [25.58, "działkowcu.", 0.99], [27.32, "Zarząd", 0.91], [28.26, "rod", 0.15], [28.46, "woźniki.", 0.9]]}