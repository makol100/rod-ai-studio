{"segs": [[2.68, 7.32, "Dzień dobry, tu Tomasz. Zakończenie sezonu działkowego Rod Woźniki."], [7.94, 12.06, "Sezon dobiega końca, plony zebrane, grządki zasłużyły na odpoczynek."], [12.6, 14.42, "A my na porządną biesiadę."], [14.62, 20.1, "Sobota 5 września 2026 roku, godzina 17."], [20.72, 23.4, "Dom działkowca, na terenie o rodę Woźniki."], [23.84, 28.0, "Co nas czeka? Kiełbaska na gorąco, kawa, ciasto i dobre rozmowy,"], [28.26, 30.36, "muzyka i wspólne tańczenie."], [30.88, 33.4, "Bawimy się podziałkowemu, wspólnym stołem."], [33.72, 37.48, "Zarząd stawia gorącą kiełbaskę, chleb, musztardę i kawę,"], [37.88, 40.44, "a każdy dokłada od siebie, co ma pod ręką."], [40.66, 43.56, "Ciasto, sałatkę, ogórki własnej roboty,"], [44.2, 46.42, "albo koszyk jabłek z własnej działki."], [46.96, 50.34, "Najważniejsze to dobry humor i rodzina, reszta się poskłada."], [50.8, 54.22, "Zapraszamy całe rodziny, dzieciaki też znajdą coś dla siebie."], [55.02, 56.74, "Do zobaczenia w działkowcu."], [58.26, 59.66, "Zarząd rod Woźniki."]], "words": [[2.68, "Dzień", 0.87], [3.48, "dobry,", 0.97], [3.84, "tu", 0.93], [3.98, "Tomasz.", 0.99], [4.52, "Zakończenie", 0.99], [5.06, "sezonu", 1.0], [5.52, "działkowego", 0.99], [6.1, "Rod", 0.29], [6.36, "Woźniki.", 0.96], [7.94, "Sezon", 0.98], [8.18, "dobiega", 0.99], [8.58, "końca,", 1.0], [9.14, "plony", 1.0], [9.4, "zebrane,", 0.99], [10.36, "grządki", 0.97], [10.76, "zasłużyły", 1.0], [11.26, "na", 1.0], [11.42, "odpoczynek.", 1.0], [12.6, "A", 0.99], [12.74, "my", 0.99], [12.84, "na", 0.94], [13.04, "porządną", 0.98], [13.5, "biesiadę.", 0.96], [14.62, "Sobota", 0.85], [15.1, "5", 0.43], [15.56, "września", 0.81], [16.16, "2026", 0.9], [17.54, "roku,", 0.92], [19.16, "godzina", 0.95], [19.5, "17.", 0.94], [20.72, "Dom", 0.78], [20.96, "działkowca,", 0.97], [21.96, "na", 1.0], [22.04, "terenie", 1.0], [22.42, "o", 0.48], [22.62, "rodę", 0.78], [22.78, "Woźniki.", 0.99], [23.84, "Co", 1.0], [24.0, "nas", 0.99], [24.16, "czeka?", 0.98], [