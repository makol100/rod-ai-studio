#!/usr/bin/env python3
"""Testy Hans Ucho — sprawdzanie odbioru słów Tomasza z Telegrama.

Testy NIE odpalają prawdziwego Telegrama — podmieniają requests.get atrapą.
Testy NIE piszą do prawdziwego wiedza/SLOWA_TOMASZA.md — używają HANS_SLOWA_PATH.

Wymagania z polecenia Tomasza (3.08.2026):
  (a) wiadomość od Tomasza -> dopisana do pliku dosłownie;
  (b) ta sama wiadomość drugi raz -> NIE dublowana (offset działa);
  (c) wiadomość od kogoś innego -> ignorowana;
  (d) brak sieci/tokenu -> zgłasza i kończy, nie wywala się;
  (e) plik SLOWA_TOMASZA.md NIE traci istniejącej treści.
"""

from __future__ import annotations

import json
import os
import sys
import time
import unittest
from pathlib import Path
from tempfile import TemporaryDirectory
from unittest.mock import patch, MagicMock

tools_dir = Path(__file__).resolve().parent
repo_root = tools_dir.parent

if str(tools_dir) not in sys.path:
    sys.path.insert(0, str(tools_dir))
if str(repo_root) not in sys.path:
    sys.path.insert(1, str(repo_root))

import hans_ucho


# ── Pomocnicze ────────────────────────────────────────────────────────────

def _atrapa_requests_get(updates_list: list[dict] | None,
                         status_code: int = 200,
                         ok: bool = True) -> MagicMock:
    """Buduje atrapę requests.get zwracającą określone wyniki getUpdates."""
    atrapa = MagicMock()
    atrapa.status_code = status_code

    if updates_list is None:
        atrapa.json = MagicMock(side_effect=Exception("Invalid JSON"))
    else:
        wynik = {"ok": ok, "result": updates_list}
        atrapa.json = MagicMock(return_value=wynik)
    return atrapa


def _buduj_update(update_id: int, chat_id: int | str,
                  text: str, date: int | None = None,
                  from_id: int | str | None = None) -> dict:
    """Buduje pojedynczy update Telegrama w formacie getUpdates."""
    if date is None:
        date = int(time.time())
    if from_id is None:
        from_id = chat_id
    return {
        "update_id": update_id,
        "message": {
            "message_id": update_id,
            "chat": {"id": int(chat_id), "type": "private"},
            "from": {"id": int(from_id), "is_bot": False, "first_name": "Tomasz"},
            "date": date,
            "text": text,
        },
    }


class TestHansUcho(unittest.TestCase):
    """Testy odbioru słów Tomasza z Telegrama — atrapy zamiast prawdziwego API."""

    def setUp(self):
        """Każdy test dostaje własny katalog tymczasowy."""
        self.tmp = TemporaryDirectory()
        self.kat = Path(self.tmp.name)
        self.plik_slow = self.kat / "SLOWA_TOMASZA.md"
        self.plik_offset = self.kat / "ucho_offset.json"
        self.plik_offset.parent.mkdir(parents=True, exist_ok=True)

    def tearDown(self):
        self.tmp.cleanup()

    def _czytaj_slowa(self) -> str:
        if self.plik_slow.exists():
            return self.plik_slow.read_text(encoding="utf-8")
        return ""

    def _env(self) -> dict:
        """Zmienne środowiskowe podstawiane do każdego testu."""
        return {
            "HANS_SLOWA_PATH": str(self.plik_slow),
            "HANS_OFFSET_PATH": str(self.plik_offset),
        }

    # ── Test (a): wiadomość od Tomasza -> dopisana do pliku dosłownie ──

    def test_a_wiadomosc_od_tomasza_dopisana_doslownie(self):
        """(a) Wiadomość z chat_id == HANS_CHAT_ID trafia do SLOWA_TOMASZA.md
        dokładnie w tej formie, w jakiej przyszła — z datą i godziną."""
        tekst_tomasza = "Testowa wiadomość od Tomasza — 3 sierpnia 2026."
        token_fake = "fake_token_123"
        chat_fake = "123456789"
        updates = [_buduj_update(1001, chat_fake, tekst_tomasza, date=1691000000)]

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik, "uruchom_ucho powinno zwrócić True")
        zawartosc = self._czytaj_slowa()
        self.assertIn(tekst_tomasza, zawartosc,
                      f"Tekst Tomasza nie został znaleziony w pliku.\nZawartość: {zawartosc[:300]}")
        self.assertTrue(
            zawartosc.strip().endswith(tekst_tomasza.strip()) or tekst_tomasza in zawartosc,
            "Tekst musi być w pliku dosłownie")

    # ── Test (b): ta sama wiadomość drugi raz -> NIE dublowana ──

    def test_b_ta_sama_wiadomosc_nie_dublowana(self):
        """(b) Po przetworzeniu update_id=2001, drugie odpytanie z tym samym
        update_id NIE dopisuje tej samej wiadomości ponownie."""
        tekst_tomasza = "Wiadomość, która ma się NIE powtórzyć."
        token_fake = "fake_token_123"
        chat_fake = "123456789"
        updates = [_buduj_update(2001, chat_fake, tekst_tomasza, date=1691000100)]

        # ── Pierwsze odpytanie ──
        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik1 = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik1)
        zawartosc_po_1 = self._czytaj_slowa()
        self.assertEqual(zawartosc_po_1.count(tekst_tomasza), 1,
                         f"Tekst powinien wystąpić raz, a jest {zawartosc_po_1.count(tekst_tomasza)}")

        # ── Drugie odpytanie (te same update'y) ──
        # Hans nie powinien ich dopisać ponownie, bo offset >= 2001
        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik2 = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik2)
        zawartosc_po_2 = self._czytaj_slowa()
        self.assertEqual(zawartosc_po_2.count(tekst_tomasza), 1,
                         f"Tekst NIE powinien być zdublowany! Jest {zawartosc_po_2.count(tekst_tomasza)} razy.")

    # ── Test (c): wiadomość od kogoś innego -> ignorowana ──

    def test_c_wiadomosc_od_kogos_innego_ignorowana(self):
        """(c) Wiadomość z chat_id != HANS_CHAT_ID jest ignorowana —
        nie trafia do SLOWA_TOMASZA.md."""
        tekst_obcy = "Hej, to ja — obcy użytkownik Telegrama."
        token_fake = "fake_token_123"
        chat_fake = "123456789"      # Tomasz
        obcy_chat_id = "999888777"   # Ktoś inny

        updates = [_buduj_update(3001, obcy_chat_id, tekst_obcy, date=1691000200,
                                 from_id=obcy_chat_id)]

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik)
        zawartosc = self._czytaj_slowa()
        self.assertNotIn(tekst_obcy, zawartosc,
                         "Wiadomość od OBCEJ osoby NIE powinna trafić do pliku!")

    # ── Test (d1): brak tokenu -> zgłasza i kończy, nie wywala się ──

    def test_d1_brak_tokenu_zglasza_i_konczy(self):
        """(d1) Gdy token lub chat_id jest pusty — uruchom_ucho zwraca False,
        nie rzuca wyjątku."""
        with patch.dict(os.environ, self._env()):
            wynik = hans_ucho.uruchom_ucho("", "")
        self.assertFalse(wynik, "Bez tokenu funkcja powinna zwrócić False")

    # ── Test (d2): brak sieci -> zgłasza i kończy, nie wywala się ──

    def test_d2_brak_sieci_zglasza_i_konczy(self):
        """(d2) Gdy requests.get rzuca RequestException — funkcja kończy
        działanie z True (puste updates -> nic do zrobienia), nie wywala się."""
        import requests as req_mod

        token_fake = "fake_token_123"
        chat_fake = "123456789"

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", side_effect=req_mod.ConnectionError("brak sieci")):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        # Zenek zwraca True nawet gdy nie ma sieci (pusta lista = nic do zrobienia)
        self.assertIsInstance(wynik, bool,
                              f"Funkcja powinna zwrócić bool, a zwróciła {type(wynik)}")
        # NIE wywala się — docieramy tutaj bez wyjątku

    # ── Test (d3): HTTP error z Telegrama -> zgłasza i kończy ──

    def test_d3_http_error_zglasza_i_konczy(self):
        """(d3) Gdy Telegram zwraca status != 200 — funkcja kończy z True,
        nie wywala się."""
        token_fake = "zly_token_123"
        chat_fake = "123456789"

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get",
                   return_value=_atrapa_requests_get(None, status_code=401)):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertIsInstance(wynik, bool)
        # Nie wywala się — dotarliśmy tutaj

    # ── Test (e): plik SLOWA_TOMASZA.md NIE traci istniejącej treści ──

    def test_e_plik_nie_traci_istniejacej_tresci(self):
        """(e) Gdy SLOWA_TOMASZA.md ma już zawartość, nowe słowa Tomasza
        są DOPISYWANE — istniejąca treść pozostaje nienaruszona."""
        istniejaca_tresc = (
            "# SŁOWA TOMASZA — DO CAŁEJ ZAŁOGI\n\n"
            "## 01.08.2026\n\n"
            '> „To ja mam pierwszy wiedzieć, co się dzieje."\n\n'
        )
        self.plik_slow.write_text(istniejaca_tresc, encoding="utf-8")

        nowa_wiadomosc = "Nowa wiadomość testowa z 3 sierpnia 2026."
        token_fake = "fake_token_123"
        chat_fake = "123456789"
        updates = [_buduj_update(5001, chat_fake, nowa_wiadomosc, date=1691000300)]

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik)
        zawartosc = self._czytaj_slowa()

        # Istniejąca treść MUSI być zachowana
        self.assertTrue(
            zawartosc.startswith(istniejaca_tresc),
            f"Istniejąca treść nie jest zachowana!\n"
            f"Oczekiwany początek: {istniejaca_tresc[:100]}...\n"
            f"Rzeczywisty początek:     {zawartosc[:100]}..."
        )
        # Nowa wiadomość MUSI być w pliku
        self.assertIn(nowa_wiadomosc, zawartosc,
                      f"Nowa wiadomość nie została dopisana!")
        # Plik nie jest krótszy niż przed dopisaniem
        self.assertGreaterEqual(
            len(zawartosc), len(istniejaca_tresc) + len(nowa_wiadomosc),
            "Plik jest krótszy niż suma starej i nowej treści")

    # ── Test (f): wiele wiadomości od Tomasza w jednym odpycie ──

    def test_f_wiele_wiadomosci_w_jednym_odpycie(self):
        """Wiele wiadomości od Tomasza w jednym getUpdates — każda dopisana
        osobno, w kolejności update_id."""
        teksty = [
            "Pierwsza wiadomość Tomasza.",
            "Druga wiadomość Tomasza.",
            "Trzecia wiadomość Tomasza.",
        ]
        token_fake = "fake_token_123"
        chat_fake = "123456789"
        updates = [
            _buduj_update(6001, chat_fake, teksty[0], date=1691000400),
            _buduj_update(6002, chat_fake, teksty[1], date=1691000410),
            _buduj_update(6003, chat_fake, teksty[2], date=1691000420),
        ]

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik)
        zawartosc = self._czytaj_slowa()

        for tekst in teksty:
            self.assertIn(tekst, zawartosc,
                          f"Tekst '{tekst[:40]}...' nie został dopisany!")

        # Sprawdź kolejność
        idx = [zawartosc.index(t) for t in teksty]
        self.assertLess(idx[0], idx[1], "Wiadomości nie są w kolejności chronologicznej!")
        self.assertLess(idx[1], idx[2], "Wiadomości nie są w kolejności chronologicznej!")

    # ── Test (g): from_id Tomasza (nie chat_id) też przechwytuje ──

    def test_g_from_id_tomasza_przechwytuje(self):
        """Gdy Tomasz pisze z innego chatu (np. grupy), ale jego from_id
        pasuje do HANS_CHAT_ID — wiadomość też jest zapisywana."""
        tekst_tomasza = "Wiadomość Tomasza z grupy, nie z prywatnego chatu."
        token_fake = "fake_token_123"
        chat_fake = "123456789"     # Tomasz (jego ID)
        grupa_chat_id = "111222333" # Jakaś grupa

        updates = [_buduj_update(7001, grupa_chat_id, tekst_tomasza,
                                 date=1691000500, from_id=chat_fake)]

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get(updates)):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik)
        zawartosc = self._czytaj_slowa()
        self.assertIn(tekst_tomasza, zawartosc,
                      "Wiadomość Tomasza z grupy też powinna być zapisana (po from_id)!")

    # ── Test (h): puste updates -> nic się nie dzieje ──

    def test_h_puste_updates_nic_nie_robi(self):
        """Gdy getUpdates zwraca pustą listę — plik nie jest modyfikowany,
        funkcja zwraca True."""
        self.plik_slow.write_text("istniejąca treść\n", encoding="utf-8")
        token_fake = "fake_token_123"
        chat_fake = "123456789"

        with patch.dict(os.environ, self._env()), \
             patch.object(hans_ucho, "_wczytaj_token_hansa",
                          return_value=(token_fake, chat_fake)), \
             patch("requests.get", return_value=_atrapa_requests_get([])):

            wynik = hans_ucho.uruchom_ucho(token_fake, chat_fake)

        self.assertTrue(wynik)
        zawartosc = self._czytaj_slowa()
        self.assertEqual(zawartosc, "istniejąca treść\n",
                         "Przy pustych updates plik nie powinien się zmienić")


if __name__ == "__main__":
    unittest.main(verbosity=2)
