class TestCase:
    """Jeden przypadek testowy — nazwa, funkcja testu, oczekiwany warunek."""
    def __init__(self, nazwa, fn, warunek_opis):
        self.nazwa = nazwa
        self.fn = fn
        self.warunek_opis = warunek_opis
        self.wynik = None
        self.przeszedl = None
        self.komunikat = ""

    def uruchom(self):
        try:
            self.wynik = self.fn()
            self.przeszedl = True
            self.komunikat = "OK"
        except AssertionError as e:
            self.wynik = None
            self.przeszedl = False
            self.komunikat = f"ASSERT: {e}"
        except Exception as e:
            self.wynik = None
            self.przeszedl = False
            self.komunikat = f"{type(e).__name__}: {e}"


def utworz_pliki_testowe(katalog, pliki_dict):
    """
    Tworzy pliki w podanym katalogu.
    pliki_dict: {nazwa: tresc, ...}
    """
    os.makedirs(katalog, exist_ok=True)
    sciezki = {}
    for nazwa, tresc in pliki_dict.items():
        sciezka = os.path.join(katalog, nazwa)
        with open(sciezka, 'w', encoding='utf-8') as f:
            f.write(tresc)
        sciezki[nazwa] = sciezka
    return sciezki


# === TEST (a): BRAK SLADU w glosie, pominiety w meldunku =================

def test_a_brak_sladu_pominiety():
    """
    Glos Zenka zawiera 'BRAK SLADU: nie sprawdzono pliku /etc/config/secret.yml'.
    Meldunek Klaudka opisuje narade, ale NIE wspomina o braku sladu.
    Hans MA to wykryc.
    """
    katalog = tempfile.mkdtemp(prefix='hans_test_a_')
    try:
        # Glos Zenka z markerem BRAK SLADU
        glosy = {
            'zenek.txt': (
                "ZENEK — GLOS W NARADZIE\n"
                "POTWIERDZONE: sprawdzilem plik glowny.\n"
                "BRAK SLADU: nie sprawdzono pliku /etc/config/secret.yml\n"
                "NIE WIEM: skad pochodzi token."
            ),
            'genek.txt': "GENEK — wszystko OK.\n",
            'henio.txt': "HENIO — zgadzam sie z Zenkiem.\n",
        }
        utworz_pliki_testowe(katalog, glosy)

        # Meldunek Klaudka — NIE wspomina o BRAK SLADU ani o secret.yml
        meldunek = os.path.join(katalog, '_meldunek.txt')
        with open(meldunek, 'w', encoding='utf-8') as f:
            f.write(
                "MELDUNEK KLAUDKA:\n"
                "Narada zakonczona. Zenek sprawdzil plik glowny, "
                "Genek potwierdza, Henio sie zgadza. Wszystko w porzadku.\n"
            )

        wynik = sprawdz_narade(katalog, meldunek)

        # Hans MA miec rozbieznosci dotyczace BRAK SLADU
        assert 'rozbieznosci' in wynik, (
            f"Brak klucza 'rozbieznosci' w wyniku. Klucze: {list(wynik.keys())}"
        )
        rozbieznosci = wynik['rozbieznosci']
        assert len(rozbieznosci) > 0, (
            "Oczekiwano co najmniej 1 rozbieznosci (BRAK SLADU pominiety), "
            f"znaleziono {len(rozbieznosci)}"
        )

        # Przynajmniej jedna rozbieznosc musi dotyczyc BRAK SLADU
        znaleziono_brak_sladu = any(
            'BRAK SLADU' in str(r).upper() or 'brak sladu' in str(r).lower()
            for r in rozbieznosci
        )
        assert znaleziono_brak_sladu, (
            f"Zadna rozbieznosc nie dotyczy BRAK SLADU. Rozbieznosci: {rozbieznosci}"
        )

        # Poziom NIE moze byc OK — powinien byc ALERT lub KRYTYCZNY
        poziom = wynik.get('poziom', '')
        assert poziom != 'OK', (
            f"Poziom nie moze byc OK gdy pominiety BRAK SLADU. Jest: {poziom}"
        )

        return wynik

    finally:
        shutil.rmtree(katalog, ignore_errors=True)


