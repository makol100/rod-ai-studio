        meldunek = os.path.join(katalog, '_nieistniejacy_meldunek.txt')
        # NIE tworze tego pliku — celowo

        wynik = sprawdz_narade(katalog, meldunek)

        # Hans ma zwrocic slownik, nie rzucic wyjatku
        assert isinstance(wynik, dict), (
            f"Oczekiwano dict, a zwrocono {type(wynik).__name__}: {wynik}"
        )

        # Poziom przy braku meldunku NIE powinien byc OK
        poziom = wynik.get('poziom', '')
        assert poziom != 'OK', (
            f"Przy braku meldunku poziom nie moze byc OK. Jest: {poziom}"
        )

        # Powinna byc informacja o braku meldunku
        rozbieznosci = wynik.get('rozbieznosci', [])
        brakujace = wynik.get('brakujace_glosy', [])

        ma_info = (
            'meldun' in str(wynik).lower()
            or any('meldun' in str(r).lower() for r in rozbieznosci)
        )
        assert ma_info, (
            f"Brak informacji o braku meldunku w wyniku: {wynik}"
        )

        return wynik

    finally:
        shutil.rmtree(katalog, ignore_errors=True)


