def test_d_glos_nieodebrany():
    """
    Jeden z glosow zawiera 'GLOS NIEODEBRANY — Henio nie odpowiedzial'.
    Meldunek Klaudka mowi 'wszystkie glosy odebrane'.
    Hans MA wychwycic rozbieznosc.
    """
    katalog = tempfile.mkdtemp(prefix='hans_test_d_')
    try:
        glosy = {
            'zenek.txt': (
                "ZENEK — kod OK.\n"
                "GLOS NIEODEBRANY — Henio nie odpowiedzial w tej turze.\n"
            ),
            'genek.txt': "GENEK — OK.\n",
            'henio.txt': "HENIO — NIEODEBRANY — nie dotarlo zlecenie.\n",
        }
        utworz_pliki_testowe(katalog, glosy)

        meldunek = os.path.join(katalog, '_meldunek.txt')
        with open(meldunek, 'w', encoding='utf-8') as f:
            f.write(
                "MELDUNEK KLAUDKA:\n"
                "Wszystkie glosy odebrane. Zenek i Genek potwierdzaja. "
                "Henio tez sie wypowiedzial. Narada kompletna.\n"
            )

        wynik = sprawdz_narade(katalog, meldunek)

        assert 'rozbieznosci' in wynik, (
            f"Brak klucza 'rozbieznosci' w wyniku: {list(wynik.keys())}"
        )
        rozbieznosci = wynik['rozbieznosci']

        # Hans MA wykryc, ze meldunek mowi o kompletnosci, a glosy mowia inaczej
        znaleziono_nieodebrany = any(
            'NIEODEBRANY' in str(r).upper() or 'nieodebrany' in str(r).lower()
            or 'glos' in str(r).lower()
            for r in rozbieznosci
        )
        assert znaleziono_nieodebrany or len(rozbieznosci) > 0, (
            f"Oczekiwano rozbieznosci dotyczacej nieodebranego glosu. "
            f"Rozbieznosci: {rozbieznosci}"
        )

        # Poziom NIE OK
        poziom = wynik.get('poziom', '')
        assert poziom != 'OK', (
            f"Poziom nie moze byc OK przy nieodebranym glosie. Jest: {poziom}"
        )

        return wynik

    finally:
        shutil.rmtree(katalog, ignore_errors=True)


