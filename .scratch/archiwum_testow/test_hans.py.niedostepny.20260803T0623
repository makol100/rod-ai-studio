def test_b_narada_czysta():
    """
    Zaden glos nie zawiera markerow bledu.
    Meldunek zawiera podsumowanie wszystkich glosow.
    Hans przepuszcza — poziom OK, zero rozbieznosci.
    """
    katalog = tempfile.mkdtemp(prefix='hans_test_b_')
    try:
        glosy = {
            'zenek.txt': (
                "ZENEK — GLOS W NARADZIE\n"
                "POTWIERDZONE: kod zadzialal.\n"
                "Sprawdzilem pliki — wszystko zgodne.\n"
            ),
            'genek.txt': (
                "GENEK — GLOS W NARADZIE\n"
                "POTWIERDZONE: testy przeszly.\n"
                "Nie widze problemow.\n"
            ),
            'henio.txt': (
                "HENIO — GLOS W NARADZIE\n"
                "POTWIERDZONE: logi czyste.\n"
                "Zgadzam sie z reszta.\n"
            ),
        }
        utworz_pliki_testowe(katalog, glosy)

        meldunek = os.path.join(katalog, '_meldunek.txt')
        with open(meldunek, 'w', encoding='utf-8') as f:
            f.write(
                "MELDUNEK KLAUDKA:\n"
                "Narada czysta. Zenek potwierdzil kod, Genek testy, "
                "Henio logi. Wszystkie trzy glosy zgodne, zadnych markerow.\n"
            )

        wynik = sprawdz_narade(katalog, meldunek)

        # Hans powinien przepuscic — poziom OK, brak rozbieznosci
        poziom = wynik.get('poziom', '')
        assert poziom == 'OK', (
            f"Oczekiwano poziomu OK przy czystej naradzie, a jest: {poziom}"
        )

        rozbieznosci = wynik.get('rozbieznosci', [])
        assert len(rozbieznosci) == 0, (
            f"Oczekiwano 0 rozbieznosci przy czystej naradzie, "
            f"znaleziono {len(rozbieznosci)}: {rozbieznosci}"
